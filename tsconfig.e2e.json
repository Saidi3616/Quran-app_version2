{
  // Playwright tests run in Node, but code inside page.evaluate() runs in the browser,
  // so these files need both the Node and the DOM type definitions.
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "lib": ["ES2023", "DOM"]
  },
  "include": ["playwright.config.ts", "tests"]
}
